<Window x:Class="LiveCaptions.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:LiveCaptions.Desktop.Views"
 Title="言川 · 会议转写">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources><views:BooleanVisibilityConverter x:Key="BoolVisibility"/><SolidColorBrush x:Key="ContextRingBrush" Color="#999999"/></Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
   <Grid Padding="20,28,20,20" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8"><Image Source="ms-appx:///Assets/AppIcon.png" Width="32" Height="32"/><TextBlock Text="言川" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
     <Button Click="OpenCaptions" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="实时字幕" AutomationProperties.Name="实时字幕"><SymbolIcon Symbol="ClosedCaption"/></Button>
     <Button Click="EditTemplates" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="提示词模板" AutomationProperties.Name="提示词模板"><FontIcon Glyph="&#xE8A5;" FontSize="19"/></Button>
     <Button Click="EditProfiles" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="API 配置" AutomationProperties.Name="API 配置"><FontIcon Glyph="&#xE774;" FontSize="19"/></Button>
     <Button Click="ManageModels" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="识别模型" AutomationProperties.Name="识别模型"><FontIcon Glyph="&#xE7B8;" FontSize="19"/></Button>
    </StackPanel>
    <TextBlock Grid.Row="2" Text="历史会议" Margin="4,8,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <ListView x:Name="HistoryList" Grid.Row="3" ItemsSource="{Binding Meetings}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OpenHistory" HorizontalContentAlignment="Stretch">
     <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="4" Padding="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayTime}" FontSize="11" Opacity="0.6"/></StackPanel><Button Grid.Column="1" Click="DeleteMeeting" Tag="{Binding}" Width="28" Height="32" Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="8" ToolTipService.ToolTip="删除会议" AutomationProperties.Name="删除会议"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button></Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
     <Button x:Name="ThemeButton" Click="ToggleTheme" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="切换深色模式" AutomationProperties.Name="切换深色模式"><FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="19"/></Button>
     <Button Click="EditDevices" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="音频设备" AutomationProperties.Name="音频设备"><FontIcon Glyph="&#xE720;" FontSize="19"/></Button>
     <Button x:Name="ReconnectButton" Click="Reconnect" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="重新连接后端" AutomationProperties.Name="重新连接后端" Visibility="Collapsed"><FontIcon Glyph="&#xE72C;" FontSize="19"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="ContentArea" Grid.Column="1" Padding="28,24" RowSpacing="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="6"><TextBlock x:Name="WorkspaceTitle" Text="会议记录" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Opacity="0.65" TextWrapping="Wrap"/></StackPanel>
    <Button x:Name="ChatToggle" Grid.Column="1" Click="ToggleChat" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Width="40" Height="40" ToolTipService.ToolTip="会议问答" AutomationProperties.Name="会议问答"><FontIcon x:Name="ChatToggleIcon" Glyph="&#xE8F2;" FontSize="20"/></Button>
    <Button x:Name="ImportButton" Grid.Column="2" Click="ImportFile" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="导入录音" AutomationProperties.Name="导入录音"><FontIcon Glyph="&#xE8B5;" FontSize="20"/></Button>
    <Button x:Name="ScheduleButton" Grid.Column="3" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="自动总结设置" AutomationProperties.Name="自动总结设置">
     <FontIcon Glyph="&#xE823;" FontSize="20"/>
     <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight"><StackPanel Spacing="16" Width="260">
      <TextBlock Text="自动总结" FontSize="16" FontWeight="SemiBold"/>
      <CheckBox x:Name="Automatic" Content="启用" Checked="ScheduleChanged" Unchecked="ScheduleChanged"/>
      <NumberBox x:Name="Interval" Header="间隔（分钟）" Minimum="1" Maximum="120" Value="5" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged"/>
     </StackPanel></Flyout></Button.Flyout>
    </Button>
    <Button x:Name="StartButton" Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Click="ToggleMeeting" Width="44" Height="40" Padding="10" CornerRadius="12" VerticalAlignment="Center" ToolTipService.ToolTip="开始会议" AutomationProperties.Name="开始会议"><FontIcon x:Name="StartIcon" Glyph="&#xE7C8;" FontSize="20"/></Button>
   </Grid>
   <Grid x:Name="MeetingControls" Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TitleEdit" PlaceholderText="会议名称"/><Button Grid.Column="1" x:Name="RenameButton" Click="RenameMeeting" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="保存会议名称" AutomationProperties.Name="保存会议名称"><FontIcon Glyph="&#xE70F;" FontSize="18"/></Button></Grid>
    <ComboBox Grid.Column="1" x:Name="SourcePicker" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="系统 + 麦克风" Tag="both"/><ComboBoxItem Content="系统声音" Tag="system"/><ComboBoxItem Content="麦克风" Tag="microphone"/></ComboBox>
    <ComboBox Grid.Column="2" x:Name="LanguagePicker" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="自动语言" Tag="auto"/><ComboBoxItem Content="中文" Tag="zh"/><ComboBoxItem Content="日本語" Tag="ja"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
   </Grid>
   <InfoBar Grid.Row="2" x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True"/>
   <Grid Grid.Row="3" x:Name="Workspace" ColumnSpacing="16" SizeChanged="WorkspaceResized"><Grid.ColumnDefinitions><ColumnDefinition x:Name="TranscriptColumn" Width="*"/><ColumnDefinition x:Name="SummaryColumn" Width="*"/><ColumnDefinition x:Name="ChatColumn" Width="0"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <RadioButtons x:Name="ContentTabs" Grid.ColumnSpan="2" Visibility="Collapsed" MaxColumns="2" SelectedIndex="0" SelectionChanged="ContentTabChanged" Margin="0,0,0,12"><x:String>会议转写</x:String><x:String>AI 总结</x:String></RadioButtons>
    <Border x:Name="TranscriptPanel" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
     <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="会议转写" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="CopyTranscriptButton" Tag="transcript" Click="CopyContent" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="复制全部转写" AutomationProperties.Name="复制全部转写"><FontIcon Glyph="&#xE8C8;" FontSize="16"/></Button></Grid>
      <ListView Grid.Row="1" x:Name="TranscriptList" ItemsSource="{Binding Entries}" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
       <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="8" Padding="0,10"><TextBlock Text="{Binding Time}" FontSize="11" Opacity="0.55"/><TextBlock Text="{Binding Text}" FontSize="16" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="27"/></StackPanel></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <Border Grid.Row="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12"><TextBlock Text="{Binding LiveText}" TextWrapping="Wrap" Opacity="0.7"/></Border>
     </Grid>
    </Border>
    <Border x:Name="SummaryPanel" Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
     <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AI 总结" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button x:Name="CopySummaryButton" Tag="summaries" Click="CopyContent" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="复制全部总结" AutomationProperties.Name="复制全部总结"><FontIcon Glyph="&#xE8C8;" FontSize="16"/></Button><Button x:Name="SummaryButton" Click="Summarize" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="手动总结" AutomationProperties.Name="手动总结"><FontIcon x:Name="SummaryIcon" Glyph="&#xE945;" FontSize="18"/></Button></StackPanel></Grid>
      <ListView Grid.Row="1" x:Name="SummaryList" ItemsSource="{Binding Summaries}" SelectionMode="None" HorizontalContentAlignment="Stretch">
       <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="8" Padding="0,10"><TextBlock Text="{Binding Time}" FontSize="11" Opacity="0.55"/><views:MarkdownView Text="{Binding Text}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <TextBlock Grid.Row="2" Text="{Binding SummaryStatus}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
     </Grid>
    </Border>
    <Border x:Name="ChatPanel" Grid.Column="2" Grid.RowSpan="2" Visibility="Collapsed">
     <Grid RowSpacing="16" MaxWidth="1080" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding MeetingTitle}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="8,8,8,0"/>
      <ListView Grid.Row="1" x:Name="ChatList" ItemsSource="{Binding ChatMessages}" SelectionMode="None" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,8">
       <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="10" Padding="8,12,8,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" FontSize="13" Opacity="0.65" VerticalAlignment="Center"/><Button Grid.Column="1" Tag="{Binding Text}" Click="CopyChatMessage" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="复制内容" AutomationProperties.Name="复制内容"><FontIcon Glyph="&#xE8C8;" FontSize="14"/></Button></Grid><views:MarkdownView Text="{Binding Text}"/><TextBlock Text="{Binding StateText}" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/><Button Tag="{Binding RequestId}" Click="RetryChat" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="重试" AutomationProperties.Name="重试"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button></StackPanel></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <Border Grid.Row="2" CornerRadius="24" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12,10,12,10">
       <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="ChatInput" PlaceholderText="询问会议内容…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" MaxHeight="180" Padding="12,8" BorderThickness="0" Background="Transparent" TextChanged="ChatInputChanged" PreviewKeyDown="ChatInputKeyDown" FontSize="16">
         <TextBox.Resources>
          <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
          <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
          <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
         </TextBox.Resources>
        </TextBox>
        <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button x:Name="ChatOptionsButton" Grid.Column="1" Click="OpenChatOptions" Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="16" AutomationProperties.Name="选择模型与思考强度">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" FontSize="17"/><TextBlock x:Name="ChatEffortLabel" Text="默认" VerticalAlignment="Center"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel>
         </Button>
         <Button x:Name="ChatContextButton" Grid.Column="2" Width="36" Height="36" Padding="7" Background="Transparent" BorderThickness="0" CornerRadius="18" Click="ChatCapacity" AutomationProperties.Name="上下文用量，点击调整上下文长度">
          <Grid Width="20" Height="20" IsHitTestVisible="False"><Ellipse Width="18" Height="18" Stroke="{StaticResource ContextRingBrush}" StrokeThickness="2" Opacity="0.25"/><ProgressRing x:Name="ChatContextRing" Width="20" Height="20" MinWidth="20" MinHeight="20" IsIndeterminate="False" IsActive="True" Minimum="0" Maximum="100" Value="0"/></Grid>
         </Button>
         <Button Grid.Column="3" x:Name="ChatCancelButton" Click="CancelChat" Width="36" Height="36" Padding="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0" CornerRadius="18" ToolTipService.ToolTip="停止等待" AutomationProperties.Name="停止等待"><FontIcon Glyph="&#xE71A;" FontSize="14"/></Button>
         <Button Grid.Column="4" x:Name="ChatSendButton" Click="SendChat" Width="36" Height="36" Padding="8" Background="{ThemeResource TextFillColorPrimaryBrush}" Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderThickness="0" CornerRadius="18" ToolTipService.ToolTip="发送 · Ctrl + Enter" AutomationProperties.Name="发送"><FontIcon Glyph="&#xE74A;" FontSize="18"/></Button>
        </Grid>
       </Grid>
      </Border>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="4" ColumnSpacing="10" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CopyNotice" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="CopyAllButton" Tag="all" Click="CopyContent" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="复制会议全部内容" AutomationProperties.Name="复制会议全部内容"><FontIcon Glyph="&#xE8C8;" FontSize="16"/></Button><Button Grid.Column="2" x:Name="FolderButton" Click="OpenFolder" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="打开记录目录" AutomationProperties.Name="打开记录目录"><FontIcon Glyph="&#xED25;" FontSize="18"/></Button></Grid>
  </Grid>
 </Grid>
</Window>
