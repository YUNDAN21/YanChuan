<UserControl x:Class="LiveCaptions.Desktop.Views.ApiProfilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ConnectionOption">
            <Button Content="{Binding Name}" Click="CreateProfile" MinHeight="36"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnSpacing="16" RowSpacing="12" MaxWidth="1040">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid Padding="8" RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button x:Name="NewButton" Click="ShowNewConnection" Style="{StaticResource NavigationRowButtonStyle}"
                        AutomationProperties.Name="新建连接">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="新建连接" />
                    </StackPanel>
                </Button>
                <ListView x:Name="Profiles" Grid.Row="1" SelectionMode="Single" SelectionChanged="ProfileChanged"
                          HorizontalContentAlignment="Stretch" AutomationProperties.Name="已配置的 AI 连接" />
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid x:Name="Details" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="20,12,12,0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ConnectionType" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                        <Button x:Name="CopyButton" Grid.Column="1" Click="CopyProfile" Style="{StaticResource CompactIconButtonStyle}"
                                ToolTipService.ToolTip="复制连接" AutomationProperties.Name="复制连接">
                            <FontIcon Glyph="&#xE8C8;" FontSize="15" />
                        </Button>
                        <Button x:Name="DeleteButton" Grid.Column="2" Click="DeleteProfile" Style="{StaticResource CompactIconButtonStyle}"
                                ToolTipService.ToolTip="删除连接" AutomationProperties.Name="删除连接">
                            <FontIcon Glyph="&#xE74D;" FontSize="15" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <StackPanel Margin="20,0,20,20" Spacing="14">
                            <TextBox x:Name="ProfileName" Header="配置名称" TextChanged="NameChanged" />
                            <StackPanel x:Name="HttpFields" Spacing="14">
                                <TextBox x:Name="ApiUrl" Header="API 地址" PlaceholderText="https://…/v1" TextChanged="ConnectionFieldChanged" />
                                <PasswordBox x:Name="ApiKey" Header="API 密钥" PasswordRevealMode="Hidden" PasswordChanged="ConnectionFieldChanged" />
                            </StackPanel>
                            <StackPanel x:Name="AgentFields" Spacing="6" Visibility="Collapsed">
                                <TextBox x:Name="Executable" Header="命令行程序路径" PlaceholderText="留空自动查找" TextChanged="ConnectionFieldChanged" />
                                <TextBlock x:Name="ResolvedExecutable" Style="{StaticResource SettingDescriptionStyle}"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <AutoSuggestBox x:Name="ModelInput" Header="模型" TextMemberPath="Id" TextChanged="ModelChanged"
                                                SuggestionChosen="ModelChosen" GotFocus="ShowModelSuggestions" />
                                <Button x:Name="FetchModels" Grid.Column="1" Click="FetchModelList" VerticalAlignment="Bottom"
                                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="获取模型列表" AutomationProperties.Name="获取模型列表">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="ModelNotice" Style="{StaticResource SettingDescriptionStyle}" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="NewConnection" Visibility="Collapsed" RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="20,12,12,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="新建连接" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                        <Button x:Name="BackToDetails" Grid.Column="1" Click="CancelNewConnection" Style="{StaticResource CompactIconButtonStyle}"
                                ToolTipService.ToolTip="返回连接配置" AutomationProperties.Name="返回连接配置">
                            <FontIcon Glyph="&#xE72B;" FontSize="15" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <StackPanel x:Name="PresetGroups" Margin="20,0,20,20" Spacing="16" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
            <InfoBar x:Name="SaveError" Severity="Error" IsClosable="True" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="取消" Click="CancelEdit" />
                <Button x:Name="SaveButton" Content="保存并使用" Click="SaveProfiles" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
