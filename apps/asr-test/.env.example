# Copy to .env if you want to override defaults. Model/audio stay on this machine.
LIVECAPTIONS_HOST=127.0.0.1
LIVECAPTIONS_PORT=8765
LIVECAPTIONS_MODEL_ID=Qwen/Qwen3-ASR-0.6B
LIVECAPTIONS_MODEL_PATH=models/native/qwen3-asr-0.6b-q8_0.gguf
LIVECAPTIONS_LIBRARY_PATH=runtime/native/win-x64/crispasr.dll
LIVECAPTIONS_DEVICE=vulkan
LIVECAPTIONS_PRECISION=q8_0
# Total upload duration/size and recording duration have no default cap.
# Optional deployment limits:
# LIVECAPTIONS_MAX_AUDIO_SECONDS=14400
# LIVECAPTIONS_MAX_UPLOAD_MB=2048
# LIVECAPTIONS_RECORDING_LIMIT_SECONDS=14400
LIVECAPTIONS_CAPTURE_BUFFER_SECONDS=90
LIVECAPTIONS_CAPTURE_IDLE_SECONDS=120
LIVECAPTIONS_ARCHIVE_CHUNK_SECONDS=30
LIVECAPTIONS_FILE_CHUNK_SECONDS=20
LIVECAPTIONS_SEMANTIC_MAX_SECONDS=60
LIVECAPTIONS_DATA_DIR=data
LIVECAPTIONS_MAX_INFLIGHT_REQUESTS=2
LIVECAPTIONS_LIVE_UPDATE_SECONDS=1
LIVECAPTIONS_LIVE_SEGMENT_SECONDS=16
LIVECAPTIONS_LIVE_SILENCE_SECONDS=0.6
LIVECAPTIONS_LIVE_ENERGY_THRESHOLD=0.003
LIVECAPTIONS_LIVE_SEGMENTATION=model
LIVECAPTIONS_LIVE_MAX_WAIT_SECONDS=2
LIVECAPTIONS_ENDPOINT_THRESHOLD=0.5
LIVECAPTIONS_SPEECH_THRESHOLD=0.5
LIVECAPTIONS_VAD_MODEL_PATH=models/endpoint/silero_vad.onnx
LIVECAPTIONS_ENDPOINT_MODEL_PATH=models/endpoint/smart-turn-v3.2-cpu.onnx
